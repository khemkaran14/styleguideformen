# Settings the app reads. On the VPS these live in /etc/styleguide.env (written by deploy/setup.sh).
PORT=3011
DATA_DIR=/var/lib/styleguidemen
# Accounts that become admins when they sign up or sign in (comma-separated)
ADMIN_EMAILS=you@example.com
# Set to false only when running locally over plain http
COOKIE_SECURE=true
# The public address, used in sitemaps, share links and password-reset emails
PUBLIC_URL=https://style.example.com

# Site name shown in page titles, legal pages and emails
SITE_NAME=The Ultimate Style Guide for Men
# Public contact address shown on Contact / Privacy pages; contact-form messages are emailed here
CONTACT_EMAIL=hello@example.com
# Google Search Console "HTML tag" verification code (just the content="..." value)
GOOGLE_SITE_VERIFICATION=

# Optional: outgoing email for "Forgot password". Hostinger email settings shown.
# Leave SMTP_HOST empty to turn email off; admins can still create reset links.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASS=your-mailbox-password
MAIL_FROM=hello@example.com
